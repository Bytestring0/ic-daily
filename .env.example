# 复制为 .env 使用（Node 22+ 自动读取；CI 里用 GitHub Secrets 注入）
#
# 兼容 OpenAI 接口的任意服务，三个变量都要填。
# 不填也能跑 —— 流水线会自动降级为规则模式（不调用 AI）。

LLM_BASE_URL=https://maas-api.unisound.com/v1
LLM_API_KEY=
LLM_MODEL=u2-flash

# ---------- 可选：产出规模 ----------
# EDITION_LIMIT=24        # 日报上限
# EDITION_TARGET=18       # 目标收录条数
# EDITION_MINIMUM=15      # 覆盖不足时会在质量报告中标记
# WINDOW_HOURS=48         # 原文发布日期的时间窗
# PER_SOURCE_LIMIT=8      # 单个发布方每期上限
# HISTORY_DAYS=7          # 比对最近 7 天已报道事件
# NEWS_DISCOVERY=true     # AI 规划主题检索
# NEWS_SEARCH_PROVIDER=brave  # 可选 brave / bing；无搜索 Key 时默认公共 Bing RSS
# BRAVE_SEARCH_API_KEY=   # 独立搜索服务的 Key，不能使用 LLM_API_KEY 代替
# EETOP_RSS_URL=          # 可选：替换公共公众号中转为自建 RSS 地址
# LLM_CONCURRENCY=3       # LLM 并发数
# LLM_TIMEOUT_MS=180000  # AI 单次请求超时
# FETCH_CONCURRENCY=6     # RSS 抓取并发数
# FETCH_TIMEOUT_MS=20000  # 单源超时

# ---------- 图片日报邮件（GitHub 上使用同名 Secrets，切勿提交实际地址和授权码） ----------
# MAIL_ENABLED=false     # GitHub Variables 中设为 true 才开启发送
# MAIL_TO=               # 仅从环境变量 / GitHub Secrets 读取；多个地址用逗号分隔
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=             # 发信邮箱，GitHub Secret
# SMTP_PASS=             # SMTP 授权码，GitHub Secret
# MAIL_FROM=             # 可选，默认与 SMTP_USER 相同
