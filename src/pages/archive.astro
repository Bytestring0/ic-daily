---
import Base from '../layouts/Base.astro';
import { getIndex, getEdition, formatDateCN } from '../lib/content.js';

const idx = getIndex();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const groups = {};
for (const e of idx.editions || []) {
  const ym = e.date.slice(0, 7);
  (groups[ym] ||= []).push(e);
}
const months = Object.keys(groups).sort().reverse();

const globalCats = {};
for (const e of idx.editions || []) {
  for (const [k, n] of Object.entries(e.categories || {})) {
    globalCats[k] = (globalCats[k] || 0) + n;
  }
}
const catList = Object.entries(globalCats).sort((a, b) => b[1] - a[1]);
const totalEntries = (idx.editions || []).reduce((s, e) => s + e.count, 0);

const sample = idx.editions?.length ? getEdition(idx.editions[0].date) : null;
const labelOf = (k) => sample?.entries.find((e) => e.category === k)?.categoryLabel || k;
const colorOf = (k) => sample?.entries.find((e) => e.category === k)?.categoryColor || '#888';
---

<Base title="往期归档 · 微电子简报" description="所有往期微电子与集成电路日报">
  <div class="wrap">
    <header class="hero">
      <p class="eyebrow">Archive</p>
      <h1>往期归档</h1>
      <p class="sub">
        共 <b>{idx.total}</b> 期 · 累计 <b>{totalEntries}</b> 条动态
      </p>

      {catList.length > 0 && (
        <div class="cats">
          {catList.map(([k, n]) => (
            <span class="chip" style={`--c:${colorOf(k)}`}>
              <span class="d" />{labelOf(k)}<span class="n">{n}</span>
            </span>
          ))}
        </div>
      )}
    </header>

    {idx.total === 0 && (
      <p class="empty">还没有任何期次。运行 <code>npm run daily</code> 生成第一期。</p>
    )}

    {months.map((ym) => (
      <section class="month">
        <h2 class="mh">{ym.replace('-', ' 年 ')} 月</h2>
        <div class="rows">
          {groups[ym].map((e) => {
            const d = formatDateCN(e.date);
            const [, , dd] = e.date.split('-');
            return (
              <a class="row" href={`${base}/edition/${e.date}/`}>
                <span class="day">{dd}</span>
                <span class="wk">{d.weekday.replace('星期', '周')}</span>
                <span class="desc">{e.top?.[0] || e.intro}</span>
                <span class="cnt">{e.count} 条</span>
              </a>
            );
          })}
        </div>
      </section>
    ))}
  </div>
</Base>

<style>
  .hero {
    padding: 46px 0 30px;
  }

  .hero h1 {
    font-size: clamp(30px, 5vw, 42px);
    margin: 10px 0 10px;
    letter-spacing: -0.035em;
    font-weight: 800;
  }

  .sub {
    color: var(--ink-3);
    font-size: 14px;
    margin: 0 0 20px;
  }

  .sub b {
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  .cats {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 12.5px;
    color: var(--ink-2);
    background: var(--card);
    padding: 5px 13px;
    border-radius: 999px;
    box-shadow: var(--shadow-sm);
  }

  .chip .d {
    width: 6px;
    height: 6px;
    border-radius: 2px;
    background: var(--c);
  }

  .chip .n {
    font-size: 11.5px;
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }

  .month {
    margin-top: 34px;
  }

  .mh {
    font-size: 12.5px;
    font-weight: 700;
    color: var(--ink-3);
    letter-spacing: 0.04em;
    margin: 0 0 10px;
    padding-left: 4px;
  }

  .rows {
    background: var(--card);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    padding: 8px 10px;
    display: flex;
    flex-direction: column;
  }

  .row {
    display: grid;
    grid-template-columns: 40px 40px 1fr auto;
    gap: 14px;
    align-items: center;
    padding: 11px 14px;
    border-radius: 10px;
    transition: background 0.15s;
  }

  .row:hover {
    background: var(--card-soft);
  }

  .row + .row {
    border-top: 1px solid var(--line);
  }

  .day {
    font-size: 16px;
    font-weight: 700;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  .wk {
    font-size: 12px;
    color: var(--ink-3);
  }

  .desc {
    color: var(--ink-2);
    font-size: 14px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    min-width: 0;
  }

  .cnt {
    font-size: 12px;
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .empty {
    padding: 60px 0;
    color: var(--ink-3);
    font-size: 14px;
  }

  .empty code {
    font-family: var(--mono);
    background: var(--num-bg);
    padding: 2px 8px;
    border-radius: 6px;
    color: var(--accent-ink);
  }

  @media (max-width: 620px) {
    .row {
      grid-template-columns: 34px 1fr auto;
      gap: 10px;
      padding: 10px 10px;
    }
    .wk {
      display: none;
    }
    .rows {
      padding: 6px;
    }
  }
</style>
