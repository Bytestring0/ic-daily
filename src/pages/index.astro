---
import Base from '../layouts/Base.astro';
import EntryCard from '../components/EntryCard.astro';
import Sidebar from '../components/Sidebar.astro';
import { getLatest, getIndex, formatDateCN } from '../lib/content.js';

const edition = getLatest();
const idx = getIndex();
const d = edition ? formatDateCN(edition.date) : null;

// 按分类分组，同时维持全局连续编号（1..N）
const groups = [];
if (edition) {
  const seen = new Map();
  let n = 0;
  for (const e of edition.entries) {
    if (!seen.has(e.category)) {
      seen.set(e.category, {
        key: e.category,
        label: e.categoryLabel,
        color: e.categoryColor,
        items: [],
      });
    }
    seen.get(e.category).items.push({ entry: e, index: n++ });
  }
  groups.push(...seen.values());
}

const [yy, mm, dd] = edition ? edition.date.split('-') : ['', '', ''];
---

<Base
  title={edition ? `${d.full} · 微电子简报` : '微电子简报'}
  description={edition?.intro || '每日微电子与集成电路行业动态'}
>
  <div class="wrap">
    {!edition && (
      <div class="empty card">
        <p class="eyebrow">No Data</p>
        <h1>还没有日报数据</h1>
        <p>先运行 <code>npm run daily</code> 生成第一期。</p>
      </div>
    )}

    {edition && (
      <>
        <header class="hero">
          <p class="eyebrow">微电子简报 · 第 {idx.total} 期</p>
          <h1 class="datum">
            <span class="big">{mm}.{dd}</span>
            <span class="year">{yy}</span>
            <span class="wk">{d.weekday}</span>
          </h1>
          <p class="intro">{edition.intro}</p>
          <div class="chips">
            <span class="chip"><span class="k">{edition.stats.count}</span> 条动态</span>
            <span class="chip"><span class="k">{edition.stats.sources}</span> 个信息源</span>
            <span class="chip"><span class="k">{groups.length}</span> 个分类</span>
          </div>
        </header>

        <div class="layout">
          <div class="stream">
            {groups.map((g) => (
              <section class="group" id={`cat-${g.key}`}>
                <h2 class="gh">
                  <span class="gd" style={`background:${g.color}`} />
                  {g.label}
                  <span class="gn">{g.items.length}</span>
                </h2>
                <div class="gcards">
                  {g.items.map((it) => (
                    <EntryCard entry={it.entry} index={it.index} />
                  ))}
                </div>
              </section>
            ))}
          </div>

          <Sidebar edition={edition} />
        </div>
      </>
    )}
  </div>
</Base>

<style>
  .hero {
    padding: 44px 0 34px;
  }

  .datum {
    margin: 14px 0 18px;
    display: flex;
    align-items: baseline;
    gap: 14px;
    flex-wrap: wrap;
    letter-spacing: -0.045em;
  }

  .big {
    font-size: clamp(54px, 9vw, 88px);
    font-weight: 800;
    line-height: 0.95;
    color: var(--accent);
    letter-spacing: -0.055em;
    font-variant-numeric: tabular-nums;
  }

  .year {
    font-size: clamp(18px, 2.6vw, 26px);
    font-weight: 700;
    color: var(--ink-3);
    letter-spacing: -0.02em;
  }

  .wk {
    font-size: clamp(14px, 2vw, 17px);
    font-weight: 600;
    color: var(--ink-3);
  }

  .intro {
    margin: 0 0 22px;
    font-size: 16.5px;
    line-height: 1.8;
    color: var(--ink-2);
    max-width: 62ch;
  }

  .chips {
    display: flex;
    gap: 9px;
    flex-wrap: wrap;
  }

  .chip {
    font-size: 13px;
    color: var(--ink-2);
    background: var(--card);
    border-radius: 999px;
    padding: 6px 15px;
    box-shadow: var(--shadow-sm);
  }

  .chip .k {
    font-weight: 700;
    color: var(--ink);
    margin-right: 2px;
    font-variant-numeric: tabular-nums;
  }

  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 296px;
    gap: 22px;
    align-items: start;
    padding-bottom: 20px;
  }

  .stream {
    display: flex;
    flex-direction: column;
    gap: 30px;
    min-width: 0;
  }

  .group {
    scroll-margin-top: 84px;
  }

  .gh {
    display: flex;
    align-items: center;
    gap: 9px;
    margin: 0 0 12px;
    padding-left: 4px;
    font-size: 13px;
    font-weight: 700;
    color: var(--ink-2);
    letter-spacing: 0.02em;
  }

  .gd {
    width: 4px;
    height: 15px;
    border-radius: 2px;
  }

  .gn {
    font-size: 11.5px;
    font-weight: 600;
    color: var(--ink-3);
    background: var(--card);
    border-radius: 999px;
    padding: 1px 8px;
  }

  .gcards {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .empty {
    margin: 90px 0;
    padding: 70px 30px;
    text-align: center;
  }

  .empty h1 {
    font-size: 26px;
    margin: 12px 0 8px;
  }

  .empty code {
    font-family: var(--mono);
    background: var(--num-bg);
    padding: 2px 8px;
    border-radius: 6px;
    color: var(--accent-ink);
    font-size: 13.5px;
  }

  @media (max-width: 900px) {
    .layout {
      grid-template-columns: 1fr;
    }
    .hero {
      padding: 32px 0 26px;
    }
  }

  @media (max-width: 620px) {
    .datum {
      gap: 9px;
    }
    .chips {
      gap: 7px;
    }
    .chip {
      font-size: 12px;
      padding: 5px 12px;
    }
    .stream {
      gap: 24px;
    }
  }
</style>
