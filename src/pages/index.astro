---
import Base from '../layouts/Base.astro';
import Digest from '../components/Digest.astro';
import { getLatest, getIndex, formatDateCN } from '../lib/content.js';
const edition = getLatest();
const idx = getIndex();
---
<Base title={edition ? `${formatDateCN(edition.date).full} · 微电子简报` : '微电子简报'} description={edition?.intro} edition={edition}>
  {edition ? <Digest edition={edition} total={idx.total} /> : <div class="wrap empty"><h1>第一份芯闻，即将开始。</h1><p>运行 <code>npm run daily</code> 生成日报。</p></div>}
</Base>
