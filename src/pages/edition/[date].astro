---
import Base from '../../layouts/Base.astro';
import EntryCard from '../../components/EntryCard.astro';
import { getEdition, getIndex, formatDateCN } from '../../lib/content.js';

export function getStaticPaths() {
  const idx = getIndex();
  return (idx.editions || []).map((e) => ({
    params: { date: e.date },
    props: { date: e.date },
  }));
}

const { date } = Astro.props;
const edition = getEdition(date);
const d = formatDateCN(date);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const [yy, mm, dd] = date.split('-');

const idx = getIndex();
const dates = (idx.editions || []).map((e) => e.date);
const i = dates.indexOf(date);
const newer = i > 0 ? dates[i - 1] : null;
const older = i >= 0 && i < dates.length - 1 ? dates[i + 1] : null;
---

<Base title={`${d.full} · 微电子简报`} description={edition?.intro}>
  <div class="wrap">
    <nav class="crumb">
      <a href={`${base}/`}>首页</a>
      <span class="sep">/</span>
      <a href={`${base}/archive/`}>往期</a>
      <span class="sep">/</span>
      <span class="cur">{date}</span>
    </nav>

    <header class="hero">
      <p class="eyebrow">{d.weekday} · 共 {edition?.stats.count ?? 0} 条</p>
      <h1 class="datum">
        <span class="big">{mm}.{dd}</span>
        <span class="year">{yy}</span>
      </h1>
      {edition?.intro && <p class="intro">{edition.intro}</p>}
    </header>

    <div class="stream">
      {(edition?.entries || []).map((e, n) => <EntryCard entry={e} index={n} />)}
    </div>

    <nav class="pager">
      {older ? (
        <a class="pg" href={`${base}/edition/${older}/`}>
          <span class="lbl">← 更早</span>
          <span class="dt">{older}</span>
        </a>
      ) : <span />}
      {newer ? (
        <a class="pg right" href={`${base}/edition/${newer}/`}>
          <span class="lbl">更新 →</span>
          <span class="dt">{newer}</span>
        </a>
      ) : (
        <a class="pg right" href={`${base}/`}>
          <span class="lbl">回到最新 →</span>
          <span class="dt">今日</span>
        </a>
      )}
    </nav>
  </div>
</Base>

<style>
  .crumb {
    display: flex;
    gap: 7px;
    align-items: center;
    font-size: 12.5px;
    color: var(--ink-3);
    padding: 24px 0 0;
  }

  .crumb a:hover {
    color: var(--accent);
  }

  .sep {
    color: var(--ink-4);
  }

  .cur {
    color: var(--ink-2);
  }

  .hero {
    padding: 20px 0 28px;
  }

  .datum {
    margin: 12px 0 16px;
    display: flex;
    align-items: baseline;
    gap: 13px;
  }

  .big {
    font-size: clamp(44px, 7vw, 70px);
    font-weight: 800;
    line-height: 0.95;
    color: var(--accent);
    letter-spacing: -0.055em;
    font-variant-numeric: tabular-nums;
  }

  .year {
    font-size: clamp(17px, 2.4vw, 23px);
    font-weight: 700;
    color: var(--ink-3);
    letter-spacing: -0.02em;
  }

  .intro {
    margin: 0;
    color: var(--ink-2);
    font-size: 16px;
    line-height: 1.8;
    max-width: 62ch;
  }

  .stream {
    display: flex;
    flex-direction: column;
    gap: 14px;
    max-width: 860px;
  }

  .pager {
    margin-top: 40px;
    display: flex;
    justify-content: space-between;
    gap: 14px;
    max-width: 860px;
  }

  .pg {
    display: flex;
    flex-direction: column;
    gap: 3px;
    background: var(--card);
    padding: 14px 20px;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
    min-width: 152px;
    transition: transform 0.15s, box-shadow 0.15s;
  }

  .pg:hover {
    transform: translateY(-1px);
    box-shadow: 0 3px 12px rgba(24, 24, 27, 0.07);
  }

  .pg.right {
    text-align: right;
  }

  .pg .lbl {
    font-size: 11.5px;
    color: var(--ink-3);
  }

  .pg .dt {
    font-size: 14.5px;
    font-weight: 600;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }
</style>
