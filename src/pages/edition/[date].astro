---
import Base from '../../layouts/Base.astro';
import Digest from '../../components/Digest.astro';
import { getEdition, getIndex, formatDateCN } from '../../lib/content.js';
export function getStaticPaths() { return getIndex().editions.map((e) => ({ params: { date: e.date } })); }
const { date } = Astro.params;
const edition = getEdition(date);
const idx = getIndex();
---
<Base title={`${formatDateCN(date).full} · 微电子简报`} description={edition?.intro} edition={edition}><Digest edition={edition} total={idx.total - idx.editions.findIndex(e => e.date === date)} /></Base>
