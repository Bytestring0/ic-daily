---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base title="404 · 微电子简报">
  <div class="wrap nf">
    <p class="eyebrow">404</p>
    <h1>这个页面不存在</h1>
    <p class="hint">也许期次已被归档，或链接有误。</p>
    <a class="btn mono" href={`${base}/`}>← 回到今日简报</a>
  </div>
</Base>

<style>
  .nf {
    margin: 100px 0;
    padding: 76px 30px;
    background: var(--card);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    text-align: center;
  }
  .nf h1 {
    font-size: clamp(26px, 5vw, 36px);
    margin: 12px 0 10px;
    letter-spacing: -0.035em;
    font-weight: 800;
  }
  .hint {
    color: var(--ink-3);
    font-size: 14.5px;
    margin-bottom: 26px;
  }
  .btn {
    display: inline-block;
    background: var(--accent);
    padding: 10px 22px;
    border-radius: 10px;
    font-size: 14px;
    font-weight: 600;
    color: #fff;
    transition: transform 0.15s, box-shadow 0.15s;
  }
  .btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 14px color-mix(in srgb, var(--accent) 35%, transparent);
  }
</style>
