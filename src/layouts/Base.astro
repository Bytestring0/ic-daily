---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { getAllEditions, getIndex, getLatest } from '../lib/content.js';

const { title = '微电子简报', description = '每日微电子与集成电路行业动态', edition = null } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const idx = getIndex();
const latest = getLatest();
const currentDate = edition?.date || latest?.date || new Date().toLocaleDateString('sv-SE', { timeZone: 'Asia/Shanghai' });
const searchEntries = getAllEditions().flatMap((e) =>
  e.entries.map((item, i) => ({
    title: item.title,
    summary: item.summary,
    category: item.categoryLabel,
    date: e.date,
    href: `${base}/edition/${e.date}/#e-${i + 1}`,
  })),
);
const here = Astro.url.pathname.replace(/\/$/, '') || base;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="微电子简报" href={`${base}/rss.xml`} />
    <meta name="theme-color" content="#faf9f6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#16181a" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      try {
        document.documentElement.dataset.mode = localStorage.getItem('ic-mode') || 'reading';
        document.documentElement.dataset.theme = localStorage.getItem('ic-theme') || 'light';
      } catch {}
    </script>
  </head>
  <body data-base={base}>
    <a class="skip-link" href="#main">跳到正文</a>

    <aside class="left-rail" id="left-rail" aria-label="主导航">
      <a class="brand" href={`${base}/`}>
        <span class="brand-mark">芯</span>
        <span>微电子简报<small>IC DAILY</small></span>
      </a>

      <nav class="primary-nav">
        <a class:list={['nav-item', { selected: here === base }]} href={`${base}/`}>
          <Icon name="sun" />今日简报
        </a>
        <button class="nav-item" data-search-open><Icon name="search" />搜索往期<kbd>⌘K</kbd></button>
        <a class:list={['nav-item', { selected: here.endsWith('/archive') }]} href={`${base}/archive/`}>
          <Icon name="archive" />往期归档
        </a>
      </nav>

      <section
        class="calendar"
        data-date={currentDate}
        data-editions={JSON.stringify(idx.editions.map((e) => e.date))}
        aria-label="简报日历"
      >
        <div class="calendar-head">
          <button id="prev-month" aria-label="上个月">‹</button>
          <span id="calendar-title" aria-live="polite"></span>
          <button id="next-month" aria-label="下个月">›</button>
        </div>
        <div class="calendar-week">{['一', '二', '三', '四', '五', '六', '日'].map((x) => <span>{x}</span>)}</div>
        <div class="calendar-days" id="calendar-days"></div>
        <p><span />有简报的日期</p>
      </section>

      <nav class="secondary-nav">
        <a class="nav-item" href={`${base}/rss.xml`}><Icon name="rss" />RSS 订阅</a>
        <button class="nav-item" id="theme-toggle"><Icon name="sun" />明暗主题</button>
        <a class="nav-item" href={`${base}/about/`}><Icon name="info" />关于</a>
      </nav>

      <div class="rail-footer">
        <span class="live-dot" />{idx.total} 期 · 累计 {idx.editions.reduce((s, e) => s + e.count, 0)} 条
      </div>
    </aside>

    <div class="page-shell">
      <header class="topbar">
        <div class="topbar-left">
          <button class="icon-button" id="rail-toggle" aria-label="切换侧栏" aria-controls="left-rail" aria-expanded="true">
            <Icon name="panel" />
          </button>
          <span class="breadcrumb">
            {here === base ? '今日' : here.endsWith('/archive') ? '往期归档' : here.endsWith('/about') ? '关于' : currentDate}
          </span>
        </div>
        <div class="topbar-actions">
          {edition && (
            <div class="mode-switch" role="group" aria-label="阅读模式">
              <button data-mode="reading" aria-pressed="true"><Icon name="list" size={15} /><span>阅读模式</span></button>
              <button data-mode="simple" aria-pressed="false"><Icon name="grid" size={15} /><span>简洁模式</span></button>
            </div>
          )}
        </div>
      </header>

      <main id="main"><slot /></main>

      <footer class="site-foot">
        <span>IC DAILY</span>
        <span>内容由 AI 辅助整理 · 关键信息请核对原文</span>
      </footer>
    </div>

    <dialog id="search-dialog" class="search-dialog">
      <div class="dialog-heading">
        <h2>搜索往期</h2>
        <button class="icon-button" data-close="search-dialog" aria-label="关闭搜索"><Icon name="close" /></button>
      </div>
      <label class="search-field">
        <Icon name="search" />
        <input id="search-input" type="search" placeholder="标题、关键词或分类" aria-label="搜索内容" autocomplete="off" />
      </label>
      <div id="search-results" aria-live="polite"></div>
    </dialog>

    <script type="application/json" id="search-data" set:html={JSON.stringify(searchEntries).replace(/</g, '\\u003c')} />
    <script>
      import '../scripts/ui.js';
    </script>
  </body>
</html>
