---
/**
 * 单条情报卡片
 * 设计：左侧分类色条 + 序号，右侧内容。用细线分隔而非卡片阴影。
 */
const { entry, index } = Astro.props;
const e = entry;

// 重要度星级：仅 4-5 显示，减少视觉噪音
const showStars = e.importance >= 4;

function hostOf(url) {
  try {
    return new URL(url).hostname.replace(/^www\./, '');
  } catch {
    return '';
  }
}

function relTime(iso) {
  if (!iso) return '';
  const diff = Date.now() - new Date(iso).getTime();
  const h = Math.floor(diff / 3_600_000);
  if (h < 1) return '刚刚';
  if (h < 24) return `${h} 小时前`;
  const d = Math.floor(h / 24);
  if (d < 30) return `${d} 天前`;
  return new Date(iso).toISOString().slice(0, 10);
}
---

<article class="entry" style={`--cat:${e.categoryColor}`}>
  <div class="rail">
    <span class="idx mono">{String(index + 1).padStart(2, '0')}</span>
  </div>

  <div class="body">
    <div class="meta">
      <span class="cat">{e.categoryLabel}</span>
      {showStars && <span class="stars" title={`重要度 ${e.importance}/5`}>{'◆'.repeat(e.importance)}</span>}
      <span class="src mono">{e.source}</span>
      {e.published && <span class="time mono">{relTime(e.published)}</span>}
    </div>

    <h3 class="title">
      <a href={e.url} target="_blank" rel="noopener noreferrer">{e.title}</a>
    </h3>

    {e.summary && <p class="summary">{e.summary}</p>}

    {e.points && e.points.length > 0 && (
      <ul class="points">
        {e.points.map((p) => (
          <li>{p}</li>
        ))}
      </ul>
    )}

    <div class="foot">
      <a class="origin mono" href={e.url} target="_blank" rel="noopener noreferrer">
        {hostOf(e.url)} ↗
      </a>
      {e.tags && e.tags.length > 0 && (
        <span class="tags">
          {e.tags.slice(0, 3).map((t) => (
            <span class="tag">{t}</span>
          ))}
        </span>
      )}
    </div>
  </div>
</article>

<style>
  .entry {
    display: grid;
    grid-template-columns: 52px 1fr;
    border-top: 1px solid var(--line);
    transition: background 0.15s;
  }

  .entry:hover {
    background: color-mix(in srgb, var(--bg-2) 70%, transparent);
  }

  .rail {
    position: relative;
    padding-top: 20px;
  }

  /* 分类色条 */
  .rail::before {
    content: '';
    position: absolute;
    left: 24px;
    top: 20px;
    width: 2px;
    height: 22px;
    background: var(--cat);
  }

  .idx {
    position: absolute;
    left: 32px;
    top: 22px;
    font-size: 11px;
    color: var(--ink-3);
    letter-spacing: 0.04em;
  }

  .body {
    padding: 18px 0 20px;
    min-width: 0;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 7px;
  }

  .cat {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--cat);
    border: 1px solid color-mix(in srgb, var(--cat) 45%, transparent);
    background: color-mix(in srgb, var(--cat) 12%, transparent);
    padding: 1px 7px;
    border-radius: 2px;
  }

  .stars {
    font-size: 9px;
    color: var(--accent);
    letter-spacing: 1px;
  }

  .src,
  .time {
    font-size: 11.5px;
    color: var(--ink-3);
  }

  .time::before {
    content: '· ';
  }

  .title {
    margin: 0 0 8px;
    font-size: 17.5px;
    line-height: 1.45;
    font-weight: 600;
    letter-spacing: -0.008em;
  }

  .title a {
    background-image: linear-gradient(var(--accent-dim), var(--accent-dim));
    background-size: 0% 1px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    transition: background-size 0.25s ease;
  }

  .title a:hover {
    background-size: 100% 1px;
  }

  .summary {
    margin: 0;
    color: var(--ink-2);
    font-size: 14.5px;
    line-height: 1.7;
  }

  .points {
    margin: 9px 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 8px;
  }

  .points li {
    font-size: 12.5px;
    color: var(--ink-2);
    font-family: var(--mono);
    border-left: 2px solid var(--line-2);
    padding-left: 8px;
  }

  .foot {
    margin-top: 11px;
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .origin {
    font-size: 11.5px;
    color: var(--ink-3);
    border-bottom: 1px dashed var(--line-2);
    padding-bottom: 1px;
    transition: color 0.15s, border-color 0.15s;
  }

  .origin:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .tags {
    display: flex;
    gap: 5px;
  }

  .tag {
    font-size: 10.5px;
    font-family: var(--mono);
    color: var(--ink-3);
    background: var(--bg-3);
    padding: 1px 6px;
    border-radius: 2px;
  }

  @media (max-width: 640px) {
    .entry {
      grid-template-columns: 30px 1fr;
    }
    .rail::before {
      left: 8px;
    }
    .idx {
      display: none;
    }
    .title {
      font-size: 16px;
    }
    .summary {
      font-size: 14px;
    }
  }
</style>
