---
import Icon from './Icon.astro';

const { entry: e, index } = Astro.props;
let host = '';
try { host = new URL(e.url).hostname.replace(/^www\./, ''); } catch {}
const published = e.published
  ? new Date(e.published).toLocaleString('zh-CN', {
      timeZone: 'Asia/Shanghai',
      month: '2-digit',
      day: '2-digit',
      hour: '2-digit',
      minute: '2-digit',
    })
  : '';
const points = (e.points || []).slice(0, 4);
const cards = e.cards?.length ? e.cards.slice(0, 4) : points.map((body, i) => ({ heading: ['关键进展', '技术与数据', '进度与范围', '补充信息'][i], body }));
---

<article class="entry" id={`e-${index + 1}`} data-entry-title={e.title}>
  <div class="entry-meta">
    <a class="entry-number" href={`#e-${index + 1}`}>#{index + 1}</a>
    <span class="entry-cat" style={`--c:${e.categoryColor}`}>{e.categoryLabel}</span>
    {e.importance >= 4 && <span class="important">重点</span>}
    {published && <span class="entry-date">{published}</span>}
  </div>

  <h3 class="entry-title">
    <a href={e.url} target="_blank" rel="noopener noreferrer">
      {e.title}<Icon name="link" size={14} />
    </a>
  </h3>

  <div class="entry-facts">
    {e.summary && (
      <div class="fact fact-summary">
        <p>{e.summary}</p>
      </div>
    )}
    {cards.map((card) => (
      <div class="fact fact-point"><h4>{card.heading}</h4><p>{card.body}</p></div>
    ))}
  </div>

  <div class="entry-footer">
    <a class="entry-source" href={e.url} target="_blank" rel="noopener noreferrer">
      {e.source}<span>·</span>{host}<Icon name="link" size={11} />
    </a>
    {e.provenance?.evidenceType === 'feed_excerpt' && <span class="evidence-note">依据公开摘要</span>}
    {e.tags?.length > 0 && (
      <span class="entry-tags">
        {e.tags.slice(0, 3).map((t) => <span>{t}</span>)}
      </span>
    )}
  </div>
</article>
