---
/**
 * 单条情报卡片
 * 参照橘鸦卡片语言：
 *   编号方块 + 分类标签 → 大标题 → 淡色高亮摘要块 → 正文 → 底部来源
 */
const { entry, index } = Astro.props;
const e = entry;

function hostOf(url) {
  try {
    return new URL(url).hostname.replace(/^www\./, '');
  } catch {
    return '';
  }
}

function relTime(iso) {
  if (!iso) return '';
  const diff = Date.now() - new Date(iso).getTime();
  const h = Math.floor(diff / 3_600_000);
  if (h < 1) return '刚刚';
  if (h < 24) return `${h} 小时前`;
  const d = Math.floor(h / 24);
  if (d < 30) return `${d} 天前`;
  return new Date(iso).toISOString().slice(0, 10);
}

// 重要度：4-5 显示"重点"标记
const isTop = e.importance >= 4;
---

<article class="entry" id={`e-${index + 1}`}>
  <div class="head">
    <span class="num">{index + 1}</span>
    <span class="cat" style={`--c:${e.categoryColor}`}>{e.categoryLabel}</span>
    {isTop && <span class="top">重点</span>}
    <span class="meta">
      <span class="src">{e.source}</span>
      {e.published && <span class="dot">·</span>}
      {e.published && <span class="time">{relTime(e.published)}</span>}
    </span>
  </div>

  <h3 class="title">
    <a href={e.url} target="_blank" rel="noopener noreferrer">{e.title}</a>
  </h3>

  {e.summary && <div class="lead">{e.summary}</div>}

  {e.points && e.points.length > 0 && (
    <ul class="points">
      {e.points.map((p) => (
        <li>{p}</li>
      ))}
    </ul>
  )}

  <div class="foot">
    <a class="origin" href={e.url} target="_blank" rel="noopener noreferrer">
      <svg width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M6 3h7v7M13 3L3 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      {hostOf(e.url)}
    </a>
    {e.tags && e.tags.length > 0 && (
      <span class="tags">
        {e.tags.slice(0, 3).map((t) => (
          <span class="tag">{t}</span>
        ))}
      </span>
    )}
  </div>
</article>

<style>
  .entry {
    background: var(--card);
    border-radius: var(--radius-lg);
    padding: 26px 30px 22px;
    box-shadow: var(--shadow-sm);
    scroll-margin-top: 90px;
  }

  .head {
    display: flex;
    align-items: center;
    gap: 9px;
    flex-wrap: wrap;
    margin-bottom: 13px;
  }

  /* 编号方块 */
  .num {
    display: grid;
    place-items: center;
    min-width: 27px;
    height: 27px;
    padding: 0 7px;
    border-radius: 8px;
    background: var(--num-bg);
    color: var(--ink-2);
    font-size: 12.5px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.01em;
    flex-shrink: 0;
  }

  .cat {
    font-size: 11.5px;
    font-weight: 600;
    color: var(--c);
    background: color-mix(in srgb, var(--c) 10%, transparent);
    padding: 2px 9px;
    border-radius: 6px;
    letter-spacing: 0.01em;
  }

  .top {
    font-size: 10.5px;
    font-weight: 700;
    color: #fff;
    background: var(--accent);
    padding: 2px 8px;
    border-radius: 6px;
    letter-spacing: 0.03em;
  }

  .meta {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 12px;
    color: var(--ink-3);
    min-width: 0;
  }

  .src {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 180px;
  }

  .dot {
    color: var(--ink-4);
  }

  .title {
    margin: 0 0 12px;
    font-size: 20px;
    line-height: 1.5;
    font-weight: 700;
    letter-spacing: -0.018em;
    color: var(--ink);
  }

  .title a {
    transition: color 0.15s;
  }

  .title a:hover {
    color: var(--accent-ink);
  }

  /* 淡色高亮摘要块 —— 橘鸦样式里最显著的特征 */
  .lead {
    background: var(--accent-soft);
    color: var(--ink-2);
    border-radius: var(--radius-md);
    padding: 15px 19px;
    font-size: 15px;
    line-height: 1.8;
    margin-bottom: 14px;
  }

  .points {
    margin: 0 0 14px;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .points li {
    font-size: 14px;
    line-height: 1.75;
    color: var(--ink-2);
    padding-left: 16px;
    position: relative;
  }

  .points li::before {
    content: '';
    position: absolute;
    left: 3px;
    top: 10px;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--ink-4);
  }

  .foot {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    padding-top: 14px;
    border-top: 1px solid var(--line);
  }

  .origin {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 12.5px;
    color: var(--ink-3);
    transition: color 0.15s;
  }

  .origin:hover {
    color: var(--accent);
  }

  .tags {
    display: flex;
    gap: 6px;
    margin-left: auto;
  }

  .tag {
    font-size: 11.5px;
    color: var(--ink-3);
    background: var(--card-soft);
    border: 1px solid var(--line);
    padding: 1px 8px;
    border-radius: 6px;
  }

  @media (max-width: 640px) {
    .entry {
      padding: 20px 18px 17px;
      border-radius: 18px;
    }
    .title {
      font-size: 17.5px;
    }
    .lead {
      padding: 13px 15px;
      font-size: 14.5px;
    }
    .meta {
      margin-left: 0;
      width: 100%;
      order: 10;
    }
    .src {
      max-width: none;
    }
    .tags {
      margin-left: 0;
    }
  }
</style>
